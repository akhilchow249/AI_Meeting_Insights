# ─── Required ─────────────────────────────────────────────────────────────────
# HuggingFace token for pyannote diarisation model (needs model access granted)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ─── Optional: OpenAI backend for GenAI report (defaults to Ollama/llama3) ───
OPENAI_API_KEY=sk-...

# ─── Local dev (outside Docker) ───────────────────────────────────────────────
# When running `npm run dev` directly on your host (not inside Docker):
#   - Gateway must be running on localhost:8080
#   - Leave VITE_API_BASE empty (Vite proxy handles routing)
#   - Set VITE_PROXY_TARGET to where your gateway listens
VITE_PROXY_TARGET=http://localhost:8080
VITE_API_BASE=

# ─── Production deployment ────────────────────────────────────────────────────
# If you deploy the frontend as a static bundle behind nginx/CDN,
# point VITE_API_BASE at the gateway's public URL.
# Build with: VITE_API_BASE=https://api.yourapp.com npm run build
# VITE_API_BASE=https://api.yourapp.com
